# ==============================================================================
# Shri Madhwa Vadiraja Institute of Technology and Management (SMVITM)
# Department of Artificial Intelligence and Data Science
# AI-Powered Smart Inventory Management System — Environment Configuration
# ==============================================================================

PROJECT_NAME="SMVITM AI-Powered Smart Inventory Management System"
SECRET_KEY="generate-a-strong-random-secret-key-for-production-use"

# Database Connection:
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/inventory_smvitm
# If PostgreSQL is not configured, SQLite file storage is automatically used:
DATABASE_URL=sqlite:///./inventory_smvitm.db

# Access Token Validity (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration (Optional - in-app alerts logged internally if disabled)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=inventory-alerts@sode-edu.in
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=inventory-alerts@sode-edu.in

# Optional Gemini AI / LLM Integration Key
GEMINI_API_KEY=
