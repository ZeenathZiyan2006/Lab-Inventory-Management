# ==============================================================================
# Shri Madhwa Vadiraja Institute of Technology and Management (SMVITM), Bantakal
# Department of Artificial Intelligence and Data Science
# Inventory Management System — Environment Configuration Template
# ==============================================================================

# Project Details
PROJECT_NAME="SMVITM AI-Powered Smart Inventory Management System"
PROJECT_SUBTITLE="AI-Powered Smart Inventory Management System for College Laboratories"
COLLEGE_NAME="Shri Madhwa Vadiraja Institute of Technology and Management (SMVITM)"
COLLEGE_LOCATION="Bantakal, Udupi, Karnataka, India"
DEPARTMENT="Department of Artificial Intelligence and Data Science"

# Security & Session Authentication
# GENERATE A STRONG CRYPTOGRAPHIC KEY FOR PRODUCTION (e.g. `openssl rand -hex 32`)
SECRET_KEY=smvitm-secure-random-token-change-me-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite (Default for quick local development/evaluation):
DATABASE_URL=sqlite:///./inventory_smvitm.db
# PostgreSQL (For production deployment):
# DATABASE_URL=postgresql://inventory_user:your_secure_password@localhost:5432/smvitm_inventory

# File Upload Directory
UPLOAD_DIR=./uploads

# SMTP Email Notification Alerts (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=inventory-alerts@sode-edu.in
SMTP_ENABLED=false

# Optional External AI Enhancements
# System functions 100% offline with scikit-learn and grounded deterministic queries without external API keys.
GEMINI_API_KEY=
